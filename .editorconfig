# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 88

# Makefiles require real tabs, not spaces.
[Makefile]
indent_style = tab

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.{cfg,ini}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.csv]
trim_trailing_whitespace = false
insert_final_newline = false
